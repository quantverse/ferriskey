SERVER_PORT=3333
SERVER_HOST=localhost
SERVER_ROOT_PATH=

ENV=development

DATABASE_NAME=ferriskey
DATABASE_HOST=localhost
DATABASE_USER=ferriskey
DATABASE_PASSWORD=ferriskey

ADMIN_PASSWORD=admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5555

LOG_FILTER=info
LOG_JSON=false

# --- Portal security: rate limiting ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MIN=20
AUTH_RATE_LIMIT_BURST=5
# Trust X-Forwarded-For for per-IP rate limiting. Set true ONLY when the API
# sits behind a reverse proxy that OVERWRITES XForwardedFor with the real
# client address. When false (default), the limiter keys on the socket peer IP
# (fail-safe: a misconfigured/no-proxy deploy cannot be bypassed via a spoofed
# XForwardedFor header).
TRUSTED_PROXY=false

# --- Portal security: brute-force throttle ---
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECS=300
LOGIN_THROTTLE_SECS=300

# --- Portal security: Cap PoW captcha ---
# Disabled by default. When enabling, point CAP_VERIFY_URL at the Cap Standalone
# service and provide the site key + secret from the Cap dashboard.
CAP_ENABLED=false
CAP_VERIFY_URL=http://cap:3000
CAP_SITE_KEY=
CAP_SECRET=
CAP_FAIL_OPEN=false
